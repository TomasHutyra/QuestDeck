{
  "expo": {
    "name": "QuestDeck",
    "slug": "questdeck",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF8C42"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.BookdragonDev.QuestDeck",
      "versionCode": 7,
      "minSdkVersion": 24
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "./plugins/withExactAlarm",
      "./plugins/withScreenState",
      [
        "expo-image-picker",
        {
          "photosPermission": "QuestDeck saves quest memory photos to your device.",
          "cameraPermission": "QuestDeck uses the camera to capture quest memory photos."
        }
      ]
    ]
  }
}
